# Copy to .env and fill in the values you need.
# Only the keys used by the pipeline you run are required; GLM_* powers the skilllift runners.

# Runtime environment
DOCKER_IMAGE=
GATEWAY_PORT=
TMP_WORKSPACE=
TASKS_SUBDIR=
OUTPUT_SUBDIR=
DEFAULT_MODEL=
DEFAULT_PARALLEL=
HTTP_PROXY_INNER=
HTTPS_PROXY_INNER=
INTERFACE=

# OpenRouter
OPENROUTER_BASE_URL=
JUDGE_MODEL=
OPENROUTER_API_KEY=

# Tool keys
BRAVE_API_KEY=
GITHUB_TOKEN=
GH_TOKEN=

# Model providers (BASE_URL points to an OpenAI-compatible endpoint)
GPT_MODEL=
GPT_BASE_URL=
GPT_API_KEY=
GLM_MODEL=
GLM_BASE_URL=
GLM_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=
QWEN_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
MINIMAX_MODEL=
MINIMAX_BASE_URL=
MINIMAX_API_KEY=
CLAUDE_MODEL=
CLAUDE_BASE_URL=
CLAUDE_API_KEY=

# Proxy relay (if applicable)
MY_PROXY_API_KEY=
