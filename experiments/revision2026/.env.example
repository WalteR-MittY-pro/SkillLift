# Copy the relevant entries into repository-root .env on WSL. Never commit .env.
# Required for SkillLearnBench generalization and the two-model ablation:
GLM_MODEL=GLM-5.1
GLM_BASE_URL=
GLM_API_KEY=
# Shared image observation tool. Blank URL/key inherit GLM_BASE_URL/GLM_API_KEY.
GLM_VISION_MODEL=glm-5.3-flash
GLM_VISION_BASE_URL=
GLM_VISION_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Required only for historical-model reevaluation / a complete fresh Table 2:
GPT_SKILLSBENCH_MODEL=gpt-5.4-mini
GPT_SKILLSBENCH_BASE_URL=
GPT_SKILLSBENCH_API_KEY=
GPT_WILDCLAW_MODEL=gpt-5.4
GPT_WILDCLAW_BASE_URL=
GPT_WILDCLAW_API_KEY=
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_PRO_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_API_KEY=

# Only table2-rebuild generates missing historical-task one-shot skills.
# SkillLearnBench already has 20 frozen GPT-6-SOL skills committed in seeds/.
WRITER_MODEL=gpt-6-sol
WRITER_BASE_URL=
WRITER_API_KEY=

# Task-specific native benchmark access (do not silently omit these tasks):
GH_TOKEN=
GITHUB_TOKEN=
BRAVE_API_KEY=
DOCKER_IMAGE=wildclawbench-ubuntu:v1.3
